# Copy this file to .env and fill in real values:
#   cp .env.example .env
# The app loads .env via pydantic-settings (see config.py).
# Variable names are matched case-insensitively, so SECRET_KEY == secret_key.

# --- Security / JWT ---------------------------------------------------------
# REQUIRED. Must be set or the app fails to start.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Password reset ---------------------------------------------------------
RESET_TOKEN_EXPIRE_MINUTES=60
# Base URL used to build links in outgoing emails (no trailing slash).
FRONTEND_URL=http://localhost:8000

# --- Email (SMTP) -----------------------------------------------------------
# Defaults point at a local server. For local testing use Mailtrap/MailHog or
# set MAIL_SERVER=localhost and run e.g. `python -m aiosmtpd -n -l :1025`.
MAIL_SERVER=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_USE_TLS=true

# --- Uploads / pagination ---------------------------------------------------
MAX_UPLOAD_SIZE_BYTES=5242880
POSTS_PER_PAGE=10
